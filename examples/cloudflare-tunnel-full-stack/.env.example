# Cloudflare Tunnel Token
# Get this from: Cloudflare Dashboard -> Zero Trust -> Networks -> Tunnels
# Create a tunnel and copy the token from the install command
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Public hostname routed through Cloudflare (Panel)
PANEL_DOMAIN=panel.yourdomain.com

# Panel Administrator Contact
ADMIN_EMAIL=admin@yourdomain.com

# APP_URL (used by Pelican for generating links)
APP_URL=https://${PANEL_DOMAIN}

# Timezone applied to the Wings container
TZ=UTC

# Wings container user settings; leave defaults unless you need different IDs on the host
WINGS_UID=988
WINGS_GID=988
WINGS_USERNAME=pelican

# Host ports forwarded to Wings. Useful when accessing SFTP or API without Cloudflare.
WINGS_HTTP_PORT=8080
WINGS_SFTP_PORT=2022

# Docker Network Configuration
DOCKER_SUBNET=172.21.0.0/16

# PHP upload/post size limit
PHP_UPLOAD_LIMIT=256M
