# Cloudflare Tunnel Token
# Cloudflare Dashboard -> Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Public hostname routed through Cloudflare
PANEL_DOMAIN=panel.yourdomain.com

# Panel Configuration
ADMIN_EMAIL=admin@yourdomain.com
APP_URL=https://${PANEL_DOMAIN}

# LAN binding address + port for direct HTTPS access
LAN_BIND_ADDRESS=192.168.1.50
LAN_HTTPS_PORT=443

# Timezone applied to the Wings container
TZ=UTC

# Wings container user settings
WINGS_UID=988
WINGS_GID=988
WINGS_USERNAME=pelican

# Host ports forwarded to Wings for API/SFTP
WINGS_HTTP_PORT=8080
WINGS_SFTP_PORT=2022

# Docker Network Configuration
DOCKER_SUBNET=172.21.0.0/16

# PHP upload/post size limit
PHP_UPLOAD_LIMIT=256M
